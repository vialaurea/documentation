#: ../../content/via_laurea_modules/payroll/declarations/GPM_313.rst:30
#: ../../content/via_laurea_modules/payroll/declarations/NP-SD.rst:47
#: ../../content/via_laurea_modules/payroll/declarations/SAM_monthly_declaration.rst:35
#: ../../content/via_laurea_modules/payroll/reports/certificate_of_average_earnings.rst:39
