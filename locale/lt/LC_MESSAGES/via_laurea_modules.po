msgstr ""
"Suvedus darbuotojo duomenis modulyje „Darbuotojai“ ir sukūrus "
"darbo sutartį, eikite į modulį Algalapis >> "
"Ataskaitos >> Sodra >> 1-SD ataskaita:"

#
msgid "Creating a 1-SD declaration"
msgstr "Sukurti naują 1-SD deklaraciją"

#: ../../content/via_laurea_modules/payroll/declarations/1-SD.rst:29
